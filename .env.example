SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=read_products,write_products,read_files,write_files
ALLOWED_SHOP=iyhxfe-mw.myshopify.com
DATABASE_URL=file:./dev.sqlite
# Neon / Vercel: replace DATABASE_URL with the pooled PostgreSQL URL.
# Append connection_limit=3&pool_timeout=20&connect_timeout=20 to its query string.
# DIRECT_URL is the unpooled Neon connection; required only for PostgreSQL.
DIRECT_URL=

# Google Cloud: enable Search Console API and create a Web OAuth client.
# Redirect URI must be exactly https://YOUR-HOST/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google managers: comma-separated shop.myshopify.com:ShopifyUserId
GOOGLE_MANAGER_USERS=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
# Long random secret for the hosting scheduler POST /jobs/daily Authorization: Bearer ...
CRON_SECRET=

# Optional paid SEO data provider. Keep these on the server only.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional Google PageSpeed key for higher/reliable quota.
PAGESPEED_API_KEY=
