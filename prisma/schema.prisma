// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SeoWorkspace {
  shop      String   @id
  data      String
  revision  Int      @default(0)
  lockToken String?
  lockUntil DateTime?
  updatedAt DateTime @updatedAt
}

model SeoChange {
  id        String   @id @default(cuid())
  shop      String
  pageId    String
  pageTitle String
  before    String
  after     String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, createdAt])
}

model GoogleConnection {
  shop String @id
  tokens String
  properties String
  property String?
  autoSync Boolean @default(false)
  syncedAt DateTime?
  updatedAt DateTime @updatedAt
}

model GoogleOAuth {
  id String @id @default(cuid())
  shop String
  ticketHash String? @unique
  stateHash String? @unique
  verifier String?
  expiresAt DateTime
  @@index([shop])
}

model TrafficConnection {
  shop String @id
  mode String
  tokens String
  properties String
  property String
  name String
  timeZone String
  measurementId String
  updatedAt DateTime @updatedAt
}

model TrafficOAuth {
  id String @id @default(cuid())
  shop String
  ticketHash String? @unique
  stateHash String? @unique
  verifier String?
  expiresAt DateTime
  @@index([shop])
}

model VisitorTracker {
  shop String @id
  publicKey String @unique
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
}

model VisitorEvent {
  id String @id
  shop String
  visit String
  kind String
  path String
  source String
  medium String
  campaign String
  country String
  device String
  clickType String @default("")
  clickTarget String @default("")
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([shop, occurredAt])
  @@index([shop, visit, occurredAt])
  @@index([receivedAt])
}

model VisitorBotEvent {
  id String @id
  shop String
  source String
  family String
  path String
  country String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([shop, occurredAt])
  @@index([receivedAt])
}

model ImageCompression {
  id String @id @default(cuid())
  shop String
  imageId String
  original Bytes
  optimized Bytes
  mime String
  beforeHash String
  afterHash String
  beforeUpdatedAt String
  status String @default("draft")
  createdAt DateTime @default(now())
  @@index([shop, createdAt])
}

model SeoReportDelivery {
  id         String   @id
  shop       String
  reportId   String
  status     String
  providerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, createdAt])
}
